{
  "name": "@nodana/phoenixd-mpp-sdk",
  "version": "0.1.1",
  "description": "Phoenixd Lightning payment methods for the Machine Payments Protocol",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server/index.d.ts",
        "default": "./dist/server/index.js"
      },
      "require": {
        "types": "./dist/server/index.d.cts",
        "default": "./dist/server/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client/index.d.ts",
        "default": "./dist/client/index.js"
      },
      "require": {
        "types": "./dist/client/index.d.cts",
        "default": "./dist/client/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "docs",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "test:unit": "vitest run",
    "test": "npm run typecheck && npm run test:unit && npm run build && node tests/package-smoke.mjs",
    "prepublishOnly": "npm test",
    "test:redis": "vitest run --config vitest.redis.config.ts"
  },
  "peerDependencies": {
    "@nodana/phoenixd-ts": "^0.2.0",
    "mppx": "^0.13.4"
  },
  "devDependencies": {
    "@nodana/phoenixd-ts": "^0.2.0",
    "mppx": "^0.13.4",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "tsup": "^8.5.0",
    "vitest": "^4.1.11",
    "esbuild": "^0.28.2"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nodana/phoenixd-mpp-sdk.git"
  },
  "homepage": "https://github.com/nodana/phoenixd-mpp-sdk#readme",
  "bugs": {
    "url": "https://github.com/nodana/phoenixd-mpp-sdk/issues"
  }
}
